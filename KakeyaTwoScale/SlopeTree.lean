module
public import KakeyaTwoScale.StrongPopularity
public import Mathlib.Data.Finset.Union

@[expose] public section

noncomputable section
namespace KakeyaTwoScale
open Classical
open scoped BigOperators

/-- The actual finite level sets generated by a finite child family. -/
def slopeTreeLevels {A : Type*} [DecidableEq A] (roots : Finset A)
    (children : A → Finset A) : ℕ → Finset A
  | 0 => roots
  | n+1 => (slopeTreeLevels roots children n).biUnion children

theorem slopeTree_child_mem {A : Type*} [DecidableEq A] (roots : Finset A)
    (children : A → Finset A) (n : ℕ) {x y : A}
    (hx : x ∈ slopeTreeLevels roots children n) (hy : y ∈ children x) :
    y ∈ slopeTreeLevels roots children (n+1) := Finset.mem_biUnion.mpr ⟨x,hx,hy⟩

/-- Exact finite-level selection used in the advanced iteration. Terminal
chunkiness and failure-of-uniformity implying chunkiness suffice; no
monotonicity of the uniformity predicates across levels is assumed. -/
theorem exists_uniform_before_chunky {A : Type*} (levels : ℕ → Finset A)
    (Uniform Chunky : ℕ → A → Prop) (M : ℕ) (hM : 0 < M)
    (hroot : ∃ x ∈ levels 0, Uniform 0 x)
    (hterminal : ∀ x ∈ levels M, Chunky M x)
    (halternative : ∀ k < M, ∀ x ∈ levels k, ¬ Uniform k x → Chunky k x) :
    ∃ k < M, ∃ x ∈ levels k, Uniform k x ∧
      (∀ y ∈ levels (k+1), Chunky (k+1) y) := by
  have hex : ∃ k, ∀ x ∈ levels (k+1), Chunky (k+1) x := by
    refine ⟨M-1,?_⟩
    have he : M-1+1=M := by omega
    simpa only [he] using hterminal
  let k := Nat.find hex
  have hk : k < M := by
    have he : M-1+1=M := by omega
    have h := Nat.find_min' hex (by simpa only [he] using hterminal :
      ∀ x ∈ levels (M-1+1), Chunky (M-1+1) x)
    change k ≤ M-1 at h
    omega
  have hn : ∀ y ∈ levels (k+1), Chunky (k+1) y := Nat.find_spec hex
  have hu : ∃ x ∈ levels k, Uniform k x := by
    by_cases hk0 : k = 0
    · simpa only [hk0] using hroot
    · have hbad : ¬ ∀ x ∈ levels k, Chunky k x := by
        have hlt : k-1 < Nat.find hex := by change k-1 < k; omega
        have h := Nat.find_min hex hlt
        have he : k-1+1=k := by omega
        simpa only [he] using h
      push Not at hbad
      obtain ⟨x,hx,hc⟩ := hbad
      refine ⟨x,hx,?_⟩
      by_contra hnu
      exact hc (halternative k hk x hx hnu)
  obtain ⟨x,hx,hu⟩ := hu
  exact ⟨k,hk,x,hx,hu,hn⟩

/-- The large-fiber branch is an actual subset with a proved image bound. -/
def chunkyProjection {A B : Type*} [DecidableEq B] (S : Finset A) (f : A → B) (L : ℕ) : Finset A :=
  S.filter (fun x => L ≤ (S.filter (fun y => f y = f x)).card)

theorem chunkyProjection_image_bound {A B : Type*} [DecidableEq B]
    (S : Finset A) (f : A → B) (L : ℕ) :
    L*((chunkyProjection S f L).image f).card ≤ S.card := by
  let T := (chunkyProjection S f L).image f
  have hl (y) (hy : y ∈ T) : L ≤ (S.filter (fun x => f x = y)).card := by
    obtain ⟨x,hx,rfl⟩ := Finset.mem_image.mp hy
    exact (Finset.mem_filter.mp hx).2
  calc
    _ = ∑ _y ∈ T, L := by simp [Nat.mul_comm, T]
    _ ≤ ∑ y ∈ T, (S.filter (fun x => f x = y)).card := Finset.sum_le_sum hl
    _ = (S.filter (fun x => f x ∈ T)).card := Finset.sum_card_fiberwise_eq_card_filter S T f
    _ ≤ _ := Finset.card_le_card (Finset.filter_subset _ _)

theorem projection_uniform_or_chunky {A B : Type*} [DecidableEq B]
    (S : Finset A) (f : A → B) (L E : ℕ) :
    E ≤ (S.filter (fun x => (S.filter (fun y => f y = f x)).card < L)).card ∨
      ∃ Q ⊆ S, S.card-Q.card < E ∧ L*(Q.image f).card ≤ S.card := by
  by_cases h : E ≤ (S.filter (fun x => (S.filter (fun y => f y = f x)).card < L)).card
  · exact Or.inl h
  · right
    refine ⟨chunkyProjection S f L,Finset.filter_subset _ _,?_,chunkyProjection_image_bound S f L⟩
    have hp := Finset.card_filter_add_card_filter_not
      (s := S) (p := fun x => L ≤ (S.filter (fun y => f y = f x)).card)
    simp only [not_le] at hp
    change (chunkyProjection S f L).card + _ = S.card at hp
    omega

/-- Instantiate level selection with the actual small-fiber test and the
constructed large-fiber subsets. Root and terminal hypotheses are only
explicit endpoint threshold bounds, not a supplied dichotomy. -/
theorem select_projection_level {A B I : Type*} [DecidableEq B]
    (levels : ℕ → Finset I) (S : I → Finset A) (f : I → A → B)
    (L E : ℕ → I → ℕ) (M : ℕ) (hM : 0 < M)
    (hroot : ∃ i ∈ levels 0, E 0 i ≤ (S i).card ∧ (S i).card < L 0 i)
    (hterminal : ∀ i ∈ levels M, L M i = 1 ∧ 0 < E M i) :
    ∃ k < M, ∃ i ∈ levels k,
      E k i ≤ ((S i).filter (fun x => ((S i).filter (fun y => f i y = f i x)).card < L k i)).card ∧
      ∀ j ∈ levels (k+1), ∃ Q ⊆ S j,
        (S j).card-Q.card < E (k+1) j ∧ L (k+1) j*(Q.image (f j)).card ≤ (S j).card := by
  let U := fun k i => E k i ≤ ((S i).filter
    (fun x => ((S i).filter (fun y => f i y = f i x)).card < L k i)).card
  let C := fun k i => ∃ Q ⊆ S i, (S i).card-Q.card < E k i ∧
    L k i*(Q.image (f i)).card ≤ (S i).card
  apply exists_uniform_before_chunky levels U C M hM
  · obtain ⟨i,hi,hE,hL⟩ := hroot
    refine ⟨i,hi,?_⟩
    have he : (S i).filter (fun x => ((S i).filter (fun y => f i y = f i x)).card < L 0 i) = S i := by
      apply Finset.filter_eq_self.mpr
      intro x _
      exact (Finset.card_le_card (Finset.filter_subset _ _)).trans_lt hL
    dsimp [U]
    rw [he]
    exact hE
  · intro i hi
    obtain ⟨hL,hE⟩ := hterminal i hi
    refine ⟨S i,Finset.Subset.refl _,?_,?_⟩
    · simpa only [Nat.sub_self] using hE
    · rw [hL,one_mul]
      exact Finset.card_image_le
  · intro k _ i _ hn
    exact (projection_uniform_or_chunky (S i) (f i) (L k i) (E k i)).resolve_left hn

end KakeyaTwoScale
