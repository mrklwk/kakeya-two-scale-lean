#print axioms KakeyaTwoScale.exists_uniform_before_chunky
#print axioms KakeyaTwoScale.chunkyProjection_image_bound
#print axioms KakeyaTwoScale.projection_uniform_or_chunky
#print axioms KakeyaTwoScale.select_projection_level
