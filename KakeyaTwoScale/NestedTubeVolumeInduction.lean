module
public import KakeyaTwoScale.NestedTubeVolumeStep
public import KakeyaTwoScale.NestedTubeVolumeBase

@[expose] public section

open Set Metric MeasureTheory
open scoped ENNReal
noncomputable section
namespace KakeyaTwoScale

/-- Literal product generated by the backward volume recurrence. -/
def nestedVolumeWeight {r : ℕ} (d : ℕ) (sigma : Fin r→ℕ) (L A : Fin r→ℝ) (rho : ℝ) :
    List (Fin r)→ℝ
  | [] => 0
  | [i] => rho^(sigma i)*(L i)^(d-sigma i)
  | i::j::rest => (A i)^(d-sigma i)*nestedVolumeWeight d sigma L A rho (j::rest)

/-- Iteration on the exact sets, with finite volume proved from the base at
every step. No volume recurrence is supplied as an input. -/
theorem uniform_nestedTube_volume_product (n r e D : ℕ) (B kappa beta : ℝ)
    (hB : 0≤B) (hbeta : 0<beta) (levels : List (Fin r)) :
    ∃ C : ℝ, 0<C ∧ ∀ (p : TubeRecursionParameter n r e→ℝ) (sigma : Fin r→ℕ)
      (Q : ∀ i, Fin (sigma i)→MvPolynomial (Fin (n+1)) ℝ),
      0<p (Sum.inl .radius) →
      (∀ i∈levels, sigma i≤n+1 ∧
        (∀ k, (Q i k).totalDegree≤D) ∧
        (∀ x, rectangularPolynomialMap (Q i) x=0 → (fderiv ℝ (rectangularPolynomialMap (Q i)) x).range=⊤) ∧
        nestedPolynomialZero D p i={x | rectangularPolynomialMap (Q i) x=0} ∧
        0<p (Sum.inl (.length i)) ∧
        p (Sum.inl .radius)≤p (Sum.inl (.length i))/4 ∧
        beta*p (Sum.inl .radius)≤kappa*p (Sum.inl (.length i)) ∧
        1≤p (Sum.inr i) ∧ 1≤p (Sum.inr i)*beta) →
      volume (nestedTubeSet D B kappa beta levels p)≤
        ENNReal.ofReal (C*nestedVolumeWeight (n+1) sigma
          (fun i => p (Sum.inl (.length i))) (fun i => p (Sum.inr i)) (p (Sum.inl .radius)) levels) := by
  induction levels with
  | nil =>
    refine ⟨1,zero_lt_one,?_⟩
    intro p sigma Q hrho hdata
    simp [nestedTubeSet,nestedTubeFormula,nestedVolumeWeight]
  | cons i tail ih =>
    cases tail with
    | nil =>
      obtain ⟨C,hC,hbase⟩ := uniform_nestedTube_volume_base n r e D B kappa beta hB
      refine ⟨C,hC,?_⟩
      intro p sigma Q hrho hdata
      obtain ⟨hs,hQ,hreg,hzero,hL,hscale,_⟩ := hdata i (by simp)
      simpa only [nestedVolumeWeight,mul_assoc] using hbase p i (sigma i) hs (Q i) hQ hreg hzero hrho hL hscale
    | cons j rest =>
      obtain ⟨K,hK,hind⟩ := ih
      obtain ⟨C,hC,hstep⟩ := uniform_nestedTube_volume_step n r e D B kappa beta hbeta i j rest
      refine ⟨C*K,mul_pos hC hK,?_⟩
      intro p sigma Q hrho hdata
      have ht := hind p sigma Q hrho (fun z hz => hdata z (List.mem_cons_of_mem i hz))
      have hfinite : volume (nestedTubeSet D B kappa beta (j::rest) p)≠⊤ :=
        ne_top_of_le_ne_top ENNReal.ofReal_ne_top ht
      obtain ⟨hs,hQ,hreg,hzero,_hL,_hscale,_hwidth,ha,hab⟩ := hdata i (by simp)
      have hj := hdata j (by simp)
      have hv := hstep p (sigma i) hs (Q i) hQ hreg hzero hrho ha hj.2.2.2.2.2.2.1 hab hfinite
      refine hv.trans ?_
      calc
        _ ≤ ENNReal.ofReal (C*(p (Sum.inr i))^(n+1-sigma i))*
            ENNReal.ofReal (K*nestedVolumeWeight (n+1) sigma
              (fun i => p (Sum.inl (.length i))) (fun i => p (Sum.inr i)) (p (Sum.inl .radius)) (j::rest)) :=
          mul_le_mul le_rfl ht zero_le zero_le
        _ = _ := by
          rw [← ENNReal.ofReal_mul (by positivity)]
          congr 1
          simp only [nestedVolumeWeight]
          ring

end KakeyaTwoScale
#print axioms KakeyaTwoScale.uniform_nestedTube_volume_product
